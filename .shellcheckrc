# usbnp is split into sourced files that share variables, so per-file
# "unused/undefined" checks are noise. ls over sysfs/configfs names (no spaces
# there) is fine. local exists in busybox ash, dash and bash.
source-path=SCRIPTDIR
external-sources=true
disable=SC1090,SC1091,SC2034,SC3043,SC2010,SC2012,SC2045,SC2129,SC2209
